# Plantilla: copiar a apps/web/.env.local para Next.js. No usar credenciales reales en Git.
# packages/db (Drizzle CLI) carga su entorno local por separado; configurar allí DATABASE_URL.
# Confirmar el branch de Neon antes de ejecutar pruebas o herramientas de BD.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Auth.js: secreto de sesión generado localmente; debe coincidir con el entorno del despliegue.
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Solo servidor: uploader de imágenes y script manual de migración a Vercel Blob.
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_THE_BLOB_STORE_TOKEN
