generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       Role     @default(ADMIN)
  properties Property[]
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  VIEWER
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEs     String
  titleEn     String
  titleFr     String
  descEs      String
  descEn      String
  descFr      String
  address     String
  city        String
  maxGuests   Int
  bedrooms    Int
  bathrooms   Float
  published   Boolean  @default(false)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  media       Media[]
  messages    Message[]
  icalFeeds   IcalFeed[]
  bookings    Booking[]
  createdAt   DateTime @default(now())
}

model Media {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  type       MediaType @default(PHOTO)
  order      Int       @default(0)
}

enum MediaType {
  PHOTO
  VIDEO
}

model Message {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  name       String
  email      String
  phone      String?
  lang       String    @default("es")
  body       String
  startDate  DateTime?
  endDate    DateTime?
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model IcalFeed {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id])
  url          String
  source       String    @default("airbnb")
  lastSyncedAt DateTime?
  bookings     Booking[]
}

model Booking {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  icalFeedId String?
  icalFeed   IcalFeed? @relation(fields: [icalFeedId], references: [id])
  startDate  DateTime
  endDate    DateTime
  source     String    @default("manual")
  createdAt  DateTime  @default(now())

  @@index([propertyId, startDate, endDate])
}
